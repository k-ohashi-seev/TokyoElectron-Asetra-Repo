{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "issues", "checks"],
  "properties": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changes", "checked", "conclusion"],
      "properties": {
        "changes": { "type": "array", "items": { "type": "string" } },
        "checked": { "type": "string" },
        "conclusion": { "type": "string" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "severity", "category", "problem", "improvement", "fixed_code"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "category": { "type": "string", "enum": ["バグ", "セキュリティ", "設計", "性能", "デグレ"] },
          "problem": { "type": "string" },
          "improvement": { "type": "string" },
          "fixed_code": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "item", "fixed", "reason"],
        "properties": {
          "issue": { "type": "integer" },
          "item": { "type": "integer" },
          "fixed": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
