<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.rfid.Lease.LeaseSummary">

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/BackgroundColor"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ListViewHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/ListViewHeader"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingLeft="5dp"
                android:paddingTop="10dp">

                <TextView
                    android:id="@+id/lblSummaryListTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center|left"
                    android:text="資産番号・名称"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/lblSummaryListCount"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center|right"
                    android:text="件数"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtSummaryListCount"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center|right"
                    android:paddingLeft="10dp"
                    android:paddingRight="20dp"
                    android:text="0"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center|right"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblSummaryReturnLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center|right"
                    android:text="返却期限エラー"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtSummaryReturnLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center|right"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="0"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/lblSummaryListCountErr"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center|right"
                    android:text="マスタ未登録件数"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtSummaryListCountErr"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center|right"
                    android:paddingLeft="10dp"
                    android:paddingRight="20dp"
                    android:text="0"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblSummaryListNoAuthority"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center|right"
                    android:text="不可"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtSummaryListNoAuthority"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center|right"
                    android:paddingLeft="10dp"
                    android:paddingRight="20dp"
                    android:text="0"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblSummaryLeaseLimitWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center|right"
                    android:text="貸出上限 警告件数"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtSummaryLeaseLimitWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center|right"
                    android:paddingLeft="10dp"
                    android:paddingRight="20dp"
                    android:text="0"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/lblSummaryLeaseLimitErr"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center|right"
                    android:text="エラー件数"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtSummaryLeaseLimitErr"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center|right"
                    android:paddingLeft="10dp"
                    android:paddingRight="20dp"
                    android:text="0"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblSummaryLeaseLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center|right"
                    android:text="リース期限エラー"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtSummaryLeaseLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center|right"
                    android:paddingLeft="10dp"
                    android:paddingRight="20dp"
                    android:text="0"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/lblSummaryGenericLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center|right"
                    android:text="○○期限エラー"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtSummaryGenericLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center|right"
                    android:paddingLeft="10dp"
                    android:paddingRight="20dp"
                    android:text="0"
                    android:textColor="@color/ButtonMenuColor"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>

        <ListView
            android:id="@+id/listview_Summary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:divider="@color/colorPrimary"
            android:dividerHeight="2dp"
            android:scrollbars="vertical">

        </ListView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSummarClear"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:background="@drawable/execute_button_clear"
                android:drawableLeft="@drawable/trash_32"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="クリア"
                android:textAlignment="center"
                android:textColor="#ffffff"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnSummaryConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="20dp"
                android:layout_weight="1"
                android:background="@drawable/execute_button"
                android:drawableLeft="@drawable/next_32"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="登録"
                android:textAlignment="center"
                android:textColor="@color/ButtonMenuColor"
                android:textSize="20sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>