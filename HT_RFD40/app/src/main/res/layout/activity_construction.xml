<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/BackgroundColor"
	tools:context="com.rfid.Inventory.InventoryTagIn">

	<LinearLayout
		android:id="@+id/Area1"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:focusable="true"
		android:focusableInTouchMode="true"
		android:orientation="vertical">

		<TextView
			android:id="@+id/labSubTitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:layout_marginBottom="10dp"
			android:background="@color/Information"
			android:drawableLeft="@drawable/information_32"
			android:drawablePadding="10dp"
			android:gravity="center|left"
			android:paddingLeft="20dp"
			android:paddingTop="5dp"
			android:paddingRight="30dp"
			android:paddingBottom="5dp"
			android:text="貸出する工事を選択してください"
			android:textColor="@android:color/primary_text_dark"
			android:textSize="24sp" />


		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:orientation="vertical">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="@dimen/construction_sett_edit_loc"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/lbWorkDay"
					android:layout_width="312dp"
					android:layout_height="match_parent"
					android:layout_marginLeft="10dp"
					android:layout_marginRight="10dp"
					android:layout_weight="1"
					android:gravity="center_vertical"
					android:paddingLeft="10dp"
					android:text="作業実施日"
					android:textSize="18sp" />

				<EditText
					android:id="@+id/txtWorkDay"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:layout_marginRight="10dp"
					android:layout_weight="1"
					android:background="@drawable/shape_rounded_input"
					android:clickable="true"
					android:cursorVisible="false"
					android:ems="10"
					android:focusable="false"
					android:imeOptions="actionDone"
					android:inputType="none"
					android:longClickable="false"
					android:maxLength="10"
					android:paddingLeft="10dp"
					android:textSize="@dimen/loc_sett_edit_text_sp" />

				<Button
					android:id="@+id/btnSearch"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:background="@drawable/execute_button_tagon"
					android:text="@string/button_name_construction_tagread_search"
					android:textColor="@color/ButtonMenuColor" />

			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="@dimen/construction_sett_edit_loc"
				android:layout_marginTop="5dp"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/lbLiability"
					android:layout_width="312dp"
					android:layout_height="match_parent"
					android:layout_marginLeft="10dp"
					android:layout_marginRight="10dp"
					android:layout_weight="1"
					android:gravity="center_vertical"
					android:paddingLeft="10dp"
					android:text="責任者"
					android:textSize="18sp" />

				<EditText
					android:id="@+id/txtLiability"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:layout_marginRight="10dp"
					android:layout_weight="1"
					android:background="@drawable/shape_rounded_input"
					android:ems="10"
					android:imeOptions="actionDone"
					android:inputType="textEmailAddress"
					android:maxLength="10"
					android:paddingLeft="10dp"
					android:textSize="@dimen/loc_sett_edit_text_sp" />

				<Button
					android:id="@+id/btnClear"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:background="@drawable/execute_button_tagon"
					android:text="@string/button_name_construction_tagread_clear"
					android:textColor="@color/ButtonMenuColor" />

			</LinearLayout>

			<TextView
				android:id="@+id/lblListViewCount"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="30dp"
				android:layout_marginTop="7dp"
				android:layout_marginEnd="30dp"
				android:layout_marginBottom="3dp"
				android:gravity="right"
				android:text="TextView"
				android:textSize="16sp" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="24dp"
				android:layout_marginStart="30dp"
				android:layout_marginEnd="30dp"
				android:background="@color/ListViewHeader"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/lbHederWorkDay"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:gravity="center|center_vertical"
					android:text="作業日"
					android:textColor="@color/ButtonMenuColor" />

				<TextView
					android:id="@+id/lbHederLiability"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:gravity="center_vertical"
					android:text="責任者"
					android:textColor="@color/ButtonMenuColor" />

			</LinearLayout>

			<TextView
				android:id="@+id/lbHederWorkContent"
				android:layout_width="match_parent"
				android:layout_height="24dp"
				android:layout_marginStart="30dp"
				android:layout_marginEnd="30dp"
				android:background="@color/ListViewHeader"
				android:gravity="center_vertical"
				android:paddingLeft="60dp"
				android:text="作業内容"
				android:textColor="@color/ButtonMenuColor" />

		</LinearLayout>

	</LinearLayout>

	<ListView
		android:id="@+id/constRuctionListView"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_marginStart="30dp"
		android:layout_marginEnd="30dp"
		android:layout_marginBottom="20dp"
		android:choiceMode="singleChoice"
		app:layout_constraintBottom_toTopOf="@id/btnNext"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/Area1">

	</ListView>

	<Button
		android:id="@+id/btnNext"
		android:layout_width="match_parent"
		android:layout_height="60dp"
		android:layout_marginLeft="30dp"
		android:layout_marginRight="30dp"
		android:layout_marginBottom="20dp"
		android:background="@drawable/execute_button"
		android:drawableLeft="@drawable/next_48"
		android:paddingLeft="30dp"
		android:paddingTop="10dp"
		android:paddingRight="30dp"
		android:paddingBottom="10dp"
		android:text="@string/button_name_next"
		android:textAlignment="center"
		android:textColor="@color/ButtonMenuColor"
		android:textSize="24sp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>