<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="@drawable/toast_background">

    <!-- メッセージ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title_toast_server_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="end"
                android:textSize="16sp"
                android:textColor="@color/Black"
                android:text="サーバー日時：" />

            <TextView
                android:id="@+id/toast_server_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2022年11月25日 12:00"
                android:textColor="@color/Red"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title_toast_ht_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="end"
                android:textSize="16sp"
                android:textColor="@color/Black"
                android:text="HT日時：" />

            <TextView
                android:id="@+id/toast_ht_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="0dp"
                android:text="2022年11月25日 12:00"
                android:textColor="@color/Red"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/toast_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/Black"
            android:textSize="14sp"
            android:text="マスタ受信処理を中断して\nAndroidの時刻設定機能で修正してください。" />
    </LinearLayout>

</LinearLayout>